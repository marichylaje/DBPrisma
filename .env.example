# Copia este archivo a .env.local (NUNCA lo commitees) o configura estas variables en Vercel.
# Genera secretos con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# --- Base de datos ---
# URL pooled (runtime serverless)
DATABASE_URL=
# URL directa (solo migraciones: prisma migrate)
DIRECT_DATABASE_URL=

# --- Auth ---
# Firma de JWT de usuario/dispositivo (>= 32 bytes aleatorios)
APP_JWT_SECRET=
# Resend: API key solo en backend y remitente con dominio verificado.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Secreto independiente para HMAC de codigos (>= 32 caracteres aleatorios).
AUTH_EMAIL_CODE_SECRET=
# Endpoints /api/admin/* y cron (server-to-server, NUNCA en la app)
ADMIN_SECRET=
CRON_SECRET=
# Orígenes web permitidos (separados por coma)
APP_ALLOWED_ORIGINS=

# --- IAP Apple ---
APPLE_SHARED_SECRET=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_BUNDLE_ID=
APPLE_APP_APPLE_ID=
APPLE_ENVIRONMENT=
APPLE_IAP_PRIVATE_KEY_BASE64=
APPLE_ROOT_CA_BASE64=

# --- IAP Google ---
GOOGLE_PACKAGE_NAME=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_INVOKER_SA=

# --- Tracking de eventos IAP ---
EVENT_TRACKING_API_URL=
EVENT_TRACKING_API_KEY=
