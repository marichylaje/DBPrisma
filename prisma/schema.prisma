datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// RATE LIMITING (protección básica anti-abuso a nivel app)
// ----------------------------------------------------

// Contador de ventana fija compartido entre todas las instancias serverless.
// key = "<nombreRegla>:<ip>". Se actualiza con un UPSERT atómico (ver lib/rateLimit.js).
model RateLimitHit {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ----------------------------------------------------
// TABLAS PROPIAS / COMPARTIDAS DE TRACKING Y ANALÍTICA
// ----------------------------------------------------

model AnalyticsEvent {
  id         String   @id @default(cuid())
  userKey    String
  sessionId  String
  eventName  String
  screenName String?
  flowName   String?
  platform   String
  appVersion String
  language   String?
  region     String?
  role       String?
  isPaidUser Boolean?
  occurredAt DateTime
  properties Json?
  createdAt  DateTime @default(now())

  @@index([occurredAt])
  @@index([eventName, occurredAt])
  @@index([userKey, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([screenName, occurredAt])
}

model IapTrackingEvent {
  id              String   @id @default(cuid())
  source          String
  platform        String
  eventType       String
  readableMessage String
  userId          String?
  productId       String?
  occurredAt      DateTime
  createdAt       DateTime @default(now())

  @@index([occurredAt])
  @@index([eventType, occurredAt])
  @@index([userId, occurredAt])
}

// ----------------------------------------------------
// MODELOS DEL BACKEND DBPRISMA (Para no eliminarlos)
// ----------------------------------------------------

model UserEntitlement {
  userKey String @id

  subActive    Boolean   @default(false)
  subPlatform  String?
  subProductId String?
  subExpiry    DateTime?
  subStatus    String?

  appleOriginalTransactionId String? @unique

  pendingAndroid       Boolean   @default(false)
  androidPurchaseToken String?   @unique
  lastVerifyAt         DateTime?
  verifyError          String?

  trialGranted Boolean   @default(false)
  trialStart   DateTime?
  trialExpiry  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProcessedIapNotification {
  id               String   @id @default(cuid())
  source           String
  notificationId   String   @unique
  notificationType String?
  userKey          String?
  createdAt        DateTime @default(now())

  @@index([source, createdAt])
}

model UserDeck {
  id              String   @id @default(cuid())
  userKey         String
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  deckName        String
  deckDescription String?  @db.Text
  instagram       String?
  commanderName   String
  commanderId     String?
  partnerName     String?
  partnerId       String?
  cards           Json
  sideboard       Json     @default("[]")
  downloadCount   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userKey, deckName])
  @@index([userKey])
  @@index([userId])
}

model DeckDownload {
  deckKey   String   @id
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SharedDeck {
  id              String   @id @default(cuid())
  userKey         String?
  deckName        String
  deckDescription String?  @db.Text

  commanderName String
  commanderId   String?
  partnerName   String?
  partnerId     String?

  cards     Json
  sideboard Json @default("[]")

  createdAt DateTime @default(now())

  sharedType   String  @default("QR")
  tournamentId String?

  @@index([createdAt])
  @@index([tournamentId])
}

model User {
  decks                    UserDeck[]
  collections              UserCollection[]
  friendRequestsSent       Friendship[]            @relation("FriendRequester")
  friendRequestsReceived   Friendship[]            @relation("FriendAddressee")
  friendNightEventsCreated FriendNightEvent[]
  friendNightPlayerEntries FriendNightPlayer[]
  friendNightInvitesReceived FriendNightInvite[]   @relation("FriendNightInvited")
  friendNightInvitesSent   FriendNightInvite[]     @relation("FriendNightInviter")
  id                       String                  @id
  nickname                 String
  email                    String?                 @unique
  passwordHash             String?
  role                     String

  xp    Int @default(0)
  level Int @default(1)

  storeName    String?
  storeAddress String?

  statsJson  Json?
  badgesJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tournamentParticipants TournamentParticipant[]

  penalizedReports JudgeReport[] @relation("PlayerPenalized")
  judgedReports    JudgeReport[] @relation("JudgeSanc")
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User     @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@index([requesterId])
}

model FriendNightEvent {
  id              String   @id
  name            String
  startsAt        DateTime
  createdByUserId String
  createdBy       User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  players FriendNightPlayer[]
  invites FriendNightInvite[]

  @@index([createdByUserId])
}

model FriendNightPlayer {
  id       String           @id @default(cuid())
  eventId  String
  event    FriendNightEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  decks    Json             @default("[]")
  rule0    String?          @db.Text
  joinedAt DateTime         @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

model FriendNightInvite {
  id              String           @id @default(cuid())
  eventId         String
  event           FriendNightEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitedUserId   String
  invitedUser     User             @relation("FriendNightInvited", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedByUserId String
  invitedBy       User             @relation("FriendNightInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  status          String           @default("pending")
  createdAt       DateTime         @default(now())

  @@unique([eventId, invitedUserId])
  @@index([invitedUserId])
}

model Tournament {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  format      String
  status      String   @default("created")
  powerLevel  String

  locationName String
  latitude     Float
  longitude    Float

  entryFee   Int
  maxPlayers Int
  startDate  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  storeId String

  roomCode         String? @unique
  bannerUrl        String?
  isPhysical       Boolean @default(true)
  address          String?
  divisa           String  @default("EUR")
  allowProxies     Boolean @default(true)
  proxyLimit       Int     @default(10)
  requireDecklist  Boolean @default(true)
  rulesEnforcement String  @default("Regular")

  roundType    String @default("Swiss")
  currentRound Int    @default(0)
  waitlist     Json?
  admins       Json?

  prizePool   String?
  prizeDetail String? @db.Text

  participants TournamentParticipant[]
  matches      TournamentMatch[]
  judgeReports JudgeReport[]
}

model TournamentParticipant {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deckSnapshot    Json?
  roundsReport    String[]
  openToTrade     Boolean  @default(false)
  pointsProcessed Boolean  @default(false)

  paymentStatus       String  @default("Pending")
  paymentMethod       String?
  decklistUrl         String?
  commanderScryfallId String?
  decklistValidated   Boolean @default(false)

  matchPoints   Int     @default(0)
  omwPercentage Float   @default(0.0)
  gwPercentage  Float   @default(0.0)
  finalPosition Int?
  isDropped     Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([tournamentId, userId])
}

model JudgeReport {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  round       Int
  tableNumber Int?

  playerId String
  player   User   @relation("PlayerPenalized", fields: [playerId], references: [id], onDelete: Cascade)

  infractionType String
  reason         String @db.Text

  judgeId String
  judge   User   @relation("JudgeSanc", fields: [judgeId], references: [id], onDelete: Cascade)

  privateNotes String?  @db.Text
  createdAt    DateTime @default(now())
}

model TournamentMatch {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  round       Int
  tableNumber Int

  players Json
  results Json?

  status      String  @default("pending")
  reportedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tournamentId, round, tableNumber])
}

model UserCollection {
  userKey   String   @id
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model CardPriceHistory {
  cardKey   String   @id
  history   Json
  updatedAt DateTime @updatedAt
}